{
  "name": "tunnelx",
  "version": "1.0.0",
  "private": true,
  "description": "TunnelX by E11 Labs — virtual LAN for classic multiplayer games",
  "main": "electron/main.js",
  "author": "E11 Labs",
  "scripts": {
    "server": "node server/index.js",
    "client": "electron .",
    "start": "node server/index.js",
    "rebuild:native": "cd node_modules/@xiaobaidadada/node-tuntap2-wintun && npm run install",
    "postinstall": "node scripts/ensure-wintun-prebuild.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "@xiaobaidadada/node-tuntap2-wintun": "^3.0.2",
    "jmespath": "^0.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.e11labs.tunnelx",
    "productName": "TunnelX",
    "copyright": "Copyright © E11 Labs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist${/*}",
      "!**/*.md",
      "!.git${/*}",
      "!TunnelX by e11 labs.ico",
      "!TunnelX by e11 labs.png",
      "!LANBridge.pdf"
    ],
    "extraResources": [
      {
        "from": "vendor/node",
        "to": "node",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "electron/**/*",
      "native/**/*",
      "node_modules/@xiaobaidadada/node-tuntap2-wintun/**/*",
      "node_modules/jmespath/**/*",
      "**/*.node"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TunnelX",
      "installerLanguages": [
        "en_US"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
